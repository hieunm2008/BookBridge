# Replace bookbridge.example.org and certificate paths with your deployment domain.
# The SQLite file and staticfiles directory must be on persistent local storage.
server {
    listen 80;
    server_name bookbridge.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name bookbridge.example.org;
    ssl_certificate /etc/letsencrypt/live/bookbridge.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bookbridge.example.org/privkey.pem;
    client_max_body_size 1m;

    location /static/ {
        alias /srv/bookbridge/staticfiles/;
        expires 7d;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
