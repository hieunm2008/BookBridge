# Documentation only: Django reads process environment; it does not load this file.
BOOKBRIDGE_DEBUG=0
BOOKBRIDGE_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
BOOKBRIDGE_ALLOWED_HOSTS=bookbridge.example.org
BOOKBRIDGE_CSRF_ORIGINS=https://bookbridge.example.org
BOOKBRIDGE_TRUST_PROXY=1
BOOKBRIDGE_DATABASE=/srv/bookbridge-data/db.sqlite3
BOOKBRIDGE_BIND=127.0.0.1
BOOKBRIDGE_PORT=8000
BOOKBRIDGE_SUPPORT_EMAIL=
BOOKBRIDGE_LOGIN_FAILURE_LIMIT=5
BOOKBRIDGE_LOGIN_COOLOFF_MINUTES=15
